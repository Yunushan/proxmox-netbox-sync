# Copy this file to netbox_pve_env.sh and fill values

# Proxmox
export PVE_HOST="192.168.0.12"        # Proxmox node hostname/IP
export PVE_USER="netsync@pve"         # Proxmox API user (realm @pve)
export PVE_TOKEN_NAME="sync"          # Proxmox API token ID
export PVE_TOKEN_VALUE="YOUR_TOKEN_HERE"  # Proxmox API token secret
export PVE_VERIFY_SSL="false"         # Set true to verify TLS certs
export PVE_API_TIMEOUT="60"           # Proxmox API request timeout in seconds
export PVE_NODE_HOST_SUFFIX=""        # Optional suffix for per-node API host (e.g. ".example.com")
export PVE_NODE_HOST_TEMPLATE=""      # Optional template (e.g. "{node}.example.com")
export PVE_NODE_HOST_MAP=""           # Optional map (e.g. "pve1=10.0.0.1,pve2=10.0.0.2")
export PVE_NODE_ILO_SYNC=""           # Optional bool. Default is enabled; set false to disable iLO sync.
export PVE_NODE_ILO_MAP=""            # Optional map override (e.g. "node-a=192.0.2.10:443,node-b=198.51.100.20:443")
export PVE_NODE_ILO_TEMPLATE=""       # Optional template override (e.g. "mgmt-{node}.example.net:443")
export PVE_NODE_ILO_PREFIX=""         # Optional fallback prefix (e.g. "mgmt-")
export PVE_NODE_ILO_SUFFIX=""         # Optional fallback suffix (e.g. ".example.net:443")
export PVE_NODE_ILO_NPM_URL=""        # Optional NPM base URL (e.g. "https://npm.example.net")
export PVE_NODE_ILO_NPM_TOKEN=""      # Optional NPM API token (preferred)
export PVE_NODE_ILO_NPM_USERNAME=""   # Optional NPM username/email (used when token is empty)
export PVE_NODE_ILO_NPM_PASSWORD=""   # Optional NPM password (used with username)
export PVE_NODE_ILO_NPM_VERIFY_SSL="false" # Verify NPM TLS certificate
export PVE_NODE_ILO_NPM_PREFIX="ilo-" # Match NPM proxy hostnames by prefix (e.g. "ilo-node1.example.net")
export PVE_NODE_ILO_DOMAIN_SUFFIXES="" # Optional extra DNS suffixes (comma/space; e.g. "example.com example.net example.org")
export PVE_NODE_ILO_INTERFACE="iLO"   # Optional NetBox interface name for node management IP
export PVE_NODE_ILO_SET_PRIMARY="true" # Set node primary_ip4/primary_ip6 from resolved iLO IP

# Optional Forti public IP sync (disabled by default)
export PVE_FORTI_PUBLIC_IP_SYNC="false" # Optional bool. true => sync public IPv4/IPv6 from Forti interfaces, VIPs, and IP pools.
export PVE_FORTI_URL=""                 # Forti base URL (e.g. "https://forti.example.net")
export PVE_FORTI_API_TOKEN=""           # Preferred auth for REST API admin users; use this when FortiOS rejects session API login
export PVE_FORTI_USERNAME=""            # Optional session auth user (older FortiOS / logincheck-enabled API sessions)
export PVE_FORTI_PASSWORD=""            # Optional session auth password
export PVE_FORTI_VERIFY_SSL="false"     # Verify Forti TLS certificate
export PVE_FORTI_VDOM="root"            # Forti VDOM to query
export PVE_FORTI_TIMEOUT="20"           # Forti API timeout in seconds
export PVE_FORTI_WAN_INTERFACES=""      # Optional preferred WAN interfaces (e.g. "wan1,wan2")
export PVE_FORTI_MAX_RANGE_EXPANSION="2048" # Max addresses expanded from VIP/IP pool ranges per object

# Netbox
export NB_URL="https://netbox.example.com"   # NetBox base URL
export NB_TOKEN="YOUR_NETBOX_TOKEN"          # NetBox API token
export NB_VERIFY_SSL="false"                 # Set true to verify TLS certs

# Sync mode (1/safe = no deletions, 2/full = delete NetBox VMs missing in Proxmox)
# Leave blank to be prompted when running interactively.
export PVE_NB_SYNC_MODE=""
export PVE_ENV_FILE="netbox_pve_env.sh"     # Optional path for auto-updating env file defaults
export PVE_GUEST_GW_FALLBACK="true" # Use guest-agent exec to fetch gateways from VM OS
export PVE_NB_PREFIX_SYNC="true" # Optional bool. true => create missing NetBox prefixes from guest CIDRs
export PVE_NB_IP_BLOCK_REPORT="false" # Optional bool. true => log NetBox prefix utilization report
export PVE_NB_IP_BLOCK_REPORT_PATH="" # Optional CSV output path for prefix report (e.g. "/tmp/ip-block-report.csv")

# NetBox objects
export NB_CLUSTER_SLUG="pve-cluster"         # Target virtualization cluster slug
export NB_SITE_SLUG="lab"                    # Optional site slug (used for VLANs/devices/prefixes)
export NB_PREFIX_ROLE_SLUG=""                # Blank/unset auto-defaults to proxmox-prefix; set off to disable prefix role sync
export NB_VLAN_ROLE_SLUG=""                  # Blank/unset auto-defaults to proxmox-vlan; set off to disable VLAN role sync
export NB_DEVICE_ROLE_SLUG="hypervisor"      # Optional device role for nodes
export NB_DEVICE_TYPE_SLUG="proxmox-node"    # Optional device type for nodes
export NB_FORTI_DEVICE=""                    # Optional NetBox Forti device name or ID (defaults to Forti hostname)
export NB_FORTI_INTERFACE=""                 # Optional NetBox interface override (defaults to selected Forti interface)
export NB_FORTI_SET_PRIMARY="true"           # Set Forti device primary_ip4 from synced public IPv4
export NB_FORTI_SET_PRIMARY6="true"          # Set Forti device primary_ip6 from synced public IPv6
export NB_VM_POOL_CF="pool"                  # Optional VM custom field key for Proxmox pool
export NB_VM_GW4_CF="gateway4"               # Optional VM custom field key for IPv4 gateway (set empty to disable)
export NB_VM_GW6_CF="gateway6"               # Optional VM custom field key for IPv6 gateway (set empty to disable)
# Set any NB_VM_*_CF variable to empty to disable that field.
# You can also provide a comma-separated list of keys to populate multiple fields.
export NB_VM_VMID_CF="vmid"                  # Optional VM custom field key for VMID
export NB_VM_SOCKETS_CF="sockets"            # Optional VM custom field key for CPU sockets
export NB_VM_CORES_CF="cores"                # Optional VM custom field key for CPU cores per socket
export NB_VM_CPU_TYPE_CF="cpu_type"          # Optional VM custom field key for CPU type
export NB_VM_QEMU_CPU_TYPE_CF="qemu_cpu_type" # Optional VM custom field key for QEMU CPU type
export NB_VM_OS_TYPE_CF="os_type"            # Optional VM custom field key for OS type
export NB_VM_DESCRIPTION_CF="pve_description" # Optional VM custom field key for Proxmox description
export NB_VM_BOOT_DISK_CF="boot_disk"        # Optional VM custom field key for boot disk
export NB_VM_BOOT_DISK_FORMAT_CF="boot_disk_format" # Optional VM custom field key for boot disk format
export NB_VM_BOOT_DISK_STORAGE_CF="boot_disk_storage" # Optional VM custom field key for boot disk storage
export NB_VM_GUEST_AGENT_CF="guest_agent_status" # Optional VM custom field key for guest agent status
export NB_VM_MEMORY_MB_CF="memory_mb"        # Optional VM custom field key for memory in MB
export NB_VM_NODE_CF="vm_node"               # Optional VM custom field key for VM node
export NB_VM_STATUS_CF="vm_status"           # Optional VM custom field key for VM status
export NB_VM_TAGS_CF="vm_tags"               # Optional VM custom field key for VM tags (comma-separated)
export NB_VM_CPU_SOCKETS_CF="cpu_sockets"     # Optional VM custom field key for CPU sockets
export NB_VM_QEMU_CORES_PER_SOCKET_CF="qemu_cores_per_socket" # Optional VM custom field key for QEMU cores/socket
export NB_VM_QEMU_NUMA_CF="qemu_numa"         # Optional VM custom field key for QEMU NUMA
export NB_VM_QEMU_BIOS_CF="qemu_bios"         # Optional VM custom field key for QEMU BIOS type
export NB_VM_QEMU_BOOT_ORDER_CF="qemu_boot_order" # Optional VM custom field key for QEMU boot order
export NB_VM_QEMU_MACHINE_CF="qemu_machine"   # Optional VM custom field key for QEMU machine type
export NB_VM_LAST_SYNC_CF="last_sync"         # Optional VM custom field key for last sync timestamp (UTC)
export NB_VM_LAST_SYNC_TZ="+03:00"            # Offset for last sync timestamp; set "local" to use system time

